[Unit]
Description=Redeploy nestoririondo.com when GitHub has new commits
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/dokploy-poll.env
ExecStart=/usr/local/bin/dokploy-poll.sh
TimeoutStartSec=60
# Unprivileged throwaway user; systemd owns /var/lib/dokploy-poll for it.
DynamicUser=yes
StateDirectory=dokploy-poll
