---
import { render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { getPosts } from "../../content";
import { formatDate, isoDate, person } from "../../site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary } = post.data;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: person(),
};
---

<Page
  title={title}
  description={summary}
  ogType="article"
  published={date.toISOString()}
  schema={schema}
>
  <p class="meta" slot="meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
  </p>
  <Content />
  <footer class="article-footer ui" slot="footer">
    <a href="/writing">All writing</a>
  </footer>
</Page>
