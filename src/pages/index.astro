---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import portrait from "../assets/portrait.webp";
import { getPosts, getProjects } from "../content";
import { PROFILES, SITE, person } from "../site";

const posts = (await getPosts()).slice(0, 3);
const projects = await getProjects();
const profiles = PROFILES.filter(({ href }) => href);
const schema = {
  "@context": "https://schema.org",
  ...person(new URL(portrait.src, Astro.site).href),
};
---

<Base schema={schema}>
  <section class="intro">
    <div class="who">
      <Image
        class="avatar"
        src={portrait}
        alt=""
        width={64}
        height={64}
        densities={[1, 2, 3]}
        fit="cover"
        position="top"
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <h1 class="who-name">{SITE.name}</h1>
        <p class="meta">Berlin</p>
      </div>
    </div>
    <p class="statement heading">
      I’m Néstor. I lead a team building an industrial IoT platform in Berlin. I studied
      philosophy, spent a decade translating for tech companies, and now write about building
      software, leading people, and what AI changes about both.
    </p>
  </section>

  <section class="section" aria-labelledby="built">
    <h2 class="section-title label" id="built">Things I’ve built</h2>
    <ProjectList projects={projects} />
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="writing">
        <h2 class="section-title label" id="writing">Writing</h2>
        <PostList posts={posts} />
        <p class="more ui">
          <a href="/writing">All writing</a>
        </p>
      </section>
    )
  }

  <section class="section" aria-labelledby="contact">
    <h2 class="section-title label" id="contact">Contact</h2>
    <p class="contact-line">
      For roles, advisory work or a freelance project, write to me.
    </p>
    <p class="email heading"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    {
      profiles.length > 0 && (
        <ul class="profiles ui" aria-label="Elsewhere">
          {profiles.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  .who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .who-name {
    font-size: 1.15em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: var(--leading-tight);
  }

  .statement {
    font-size: var(--text-display);
    font-weight: calc(var(--heading-weight) - 100);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .contact-line,
  .email {
    font-size: var(--text-contact);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .email {
    margin-top: var(--space-3);
    font-weight: 300;
    overflow-wrap: anywhere;
  }

  .email a {
    color: var(--color-text);
  }

  .email a:hover {
    color: var(--color-accent);
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .profiles a {
    color: var(--color-text-muted);
  }

  .profiles a:hover {
    color: var(--color-text);
  }
</style>
