---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import portrait from "../assets/portrait.webp";
import { getPosts, getProjects } from "../content";
import { PROFILES, SITE } from "../site";

const posts = (await getPosts()).slice(0, 3);
const projects = await getProjects();
const profiles = PROFILES.filter(({ href }) => href);
---

<Base>
  <section class="intro">
    <h1 class="visually-hidden">{SITE.name}</h1>
    <Image
      class="portrait"
      src={portrait}
      alt="Portrait of Néstor Iriondo"
      width={96}
      height={128}
      densities={[1, 2, 3]}
      loading="eager"
      fetchpriority="high"
    />
    <p>
      I’m Néstor. I lead a team building an industrial IoT platform in Berlin. I studied
      philosophy, spent a decade translating for tech companies, and now write about building
      software, leading people, and what AI changes about both.
    </p>
  </section>

  <section class="section" aria-labelledby="built">
    <h2 class="section-title" id="built">Things I’ve built</h2>
    <ProjectList projects={projects} />
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="writing">
        <h2 class="section-title" id="writing">Writing</h2>
        <PostList posts={posts} />
        <p class="more ui">
          <a href="/writing">All writing</a>
        </p>
      </section>
    )
  }

  <section class="section" aria-labelledby="contact">
    <h2 class="section-title" id="contact">Contact</h2>
    <p>I take on a small number of freelance projects. If you have one, write to me.</p>
    <p class="contact-email"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    {
      profiles.length > 0 && (
        <ul class="profiles ui">
          {profiles.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-7);
  }

  .portrait {
    width: 4.5rem;
    height: auto;
    aspect-ratio: 3 / 4;
    margin-bottom: var(--space-4);
    border-radius: var(--radius);
  }

  .intro p {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: -0.006em;
  }

  .contact-email {
    margin-top: var(--space-3);
  }

  .profiles {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }
</style>
