---
import { NAV, SITE } from "../site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header ui quiet">
  <div class:list={["column", { "column--wide": Astro.props.wide }]}>
    <a class="site-name" href="/" aria-current={path === "/" ? "page" : undefined}>{SITE.name}</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
