---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
  /** Heading level of each title. */
  level?: 2 | 3;
  /** Show the tech stack and screenshot (projects page) or just text (homepage). */
  detailed?: boolean;
}

const { projects, level = 3, detailed = false } = Astro.props;
const Heading = `h${level}` as const;
const host = (url: string) => new URL(url).host.replace(/^www\./, "");
---

<ul class="entries">
  {
    projects.map(({ id, data }) => {
      const facts = [data.kind, ...(detailed ? data.stack : [])].join(" · ");
      return (
        <li class="entry">
          <Heading class="entry-title">
            <a href={`/projects/${id}`}>{data.title}</a>
          </Heading>
          <p class="entry-summary">{data.summary}</p>
          <p class="meta">
            {facts}
            {data.url && (
              <>
                {" · "}
                <a href={data.url}>{host(data.url)}</a>
              </>
            )}
          </p>
          {detailed && data.cover && (
            <a class="project-cover" href={`/projects/${id}`} tabindex="-1" aria-hidden="true">
              <Image src={data.cover} alt="" widths={[576, 1152]} sizes="(min-width: 40rem) 36rem, 100vw" />
            </a>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .project-cover {
    display: block;
    margin-top: var(--space-3);
  }

  .project-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top left;
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
  }
</style>
