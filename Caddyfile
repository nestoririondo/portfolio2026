# Serves the static site built by Astro (dist/ → /srv) on port 3000,
# the port Dokploy already routes to.
:3000 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Fingerprinted assets never change.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# ---- Redirects from the old site ----

	# The contact form endpoint is gone.
	@api path /api/*
	respond @api 410

	# Legal pages without a language prefix were German.
	redir /impressum /de/impressum 301
	redir /datenschutz /de/datenschutz 301

	# Old language homepages, and any other old language path.
	@oldlang {
		path /de /en /es /de/* /en/* /es/*
		not path /de/hire /de/impressum /de/datenschutz /en/impressum /en/datenschutz
	}
	redir @oldlang / 301

	# No trailing slashes: /writing/ → /writing
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1} 301

	# /writing → writing.html
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
